__pycache__/
*.pyc
.DS_Store
~$*.xlsx

# Python environments
.venv/
venv/
env/

# Editors and tooling
.idea/
.vscode/
.~lock.*#
.ipynb_checkpoints/

# Screenshots shared over sshfs
shots/

# Local agent config
.claude/settings.local.json
.claude/.cc-writes/

# Third-party source documents: licence-gated, see resources/README.md
resources/*.pdf
!resources/README.md

# The pipeline trees: mvp/ (frozen) and 0.2/ (live) have the same layout, so the same
# rules apply to both.
# Local Python environment for the notebooks
mvp/notebooks/venv/
0.2/notebooks/venv/

# AIID fetches: the JSONL is the archive and is tracked; the CSV is a
# convenience view that fetch_aiid.py regenerates from the same call.
mvp/raw/aiid/*.csv
0.2/raw/aiid/*.csv

# The front end's run state (run.py serve): local, per machine
mvp/state/run.json
mvp/state/run.json.tmp
0.2/state/run.json
0.2/state/run.json.tmp
# Retained run logs, real and test (run.py runs): local, per machine, like run.json
mvp/state/runs/
0.2/state/runs/
# The review sheets are generated by run.py review; the decision logs beside them
# (review/*.csv) are data and are committed
mvp/review/*.xlsx
mvp/review/*.xlsx.tmp
0.2/review/*.xlsx
0.2/review/*.xlsx.tmp

# The developer's private working folder: notes, plans, reviews. Never committed
mvp/.dev/
0.2/.dev/
