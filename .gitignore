__pycache__/
*.pyc
.DS_Store
~$*.xlsx

# Python environments
.venv/
venv/
env/

# Editors and tooling
.idea/
.vscode/
.~lock.*#
.ipynb_checkpoints/

# Local agent config
.claude/settings.local.json
.claude/.cc-writes/

# Third-party source documents: licence-gated, see resources/README.md
resources/*.pdf
!resources/README.md

# Local Python environment for the notebooks
mvp/notebooks/venv/

# AIID fetches: the JSONL is the archive and is tracked; the CSV is a
# convenience view that fetch_aiid.py regenerates from the same call.
mvp/raw/aiid/*.csv

# The front end's run state (run.py serve): local, per machine
mvp/state/run.json
mvp/state/run.json.tmp
# Retained run logs, real and test (run.py runs): local, per machine, like run.json
mvp/state/runs/
